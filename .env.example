# AI Lesson Creation & Research Platform - Environment Configuration

# OpenRouter AI Engine (Recommended - Supports Gemini, Gemma, Claude, Nemotron)
# Get your API key at: https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini Direct API (Alternative)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Tavily Search API (Required for live web research)
# Get your API key at: https://tavily.com/
TAVILY_API_KEY=

# YouTube Data API v3 (Required for video recommendations)
# Get your API key from Google Cloud Console: https://console.cloud.google.com/
YOUTUBE_API_KEY=

# Google Books API Key (Optional: public books search works without a key)
GOOGLE_BOOKS_API_KEY=

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///./ai_lessons.db
